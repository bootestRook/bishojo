# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
*.cfg text eol=lf
*.css text eol=lf
*.gd text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
*.godot text eol=lf
*.html text eol=lf
*.import text eol=lf
*.ini text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf


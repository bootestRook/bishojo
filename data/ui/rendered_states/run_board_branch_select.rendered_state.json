  "reference_analysis": {
    "page_name": "RunBoardPage / BranchSelect",
    "canvas_role": "手机竖屏局内路线分支选择界面",
    "major_regions": [
      "左上资源显示，复用现有 ResourcePlate / ResourceIcon / ResourceValueLabel",
      "右上菜单入口，复用现有 MenuButtonIcon",
      "上半区 2 个路线分支卡片，作为当前模式唯一新增核心交互",
      "分支卡片下方节点徽标、节点落点和连接线，作为路线关系提示",
      "下半区玩家回路、生命条和底部 HUD，复用 combat 骨架"
    ],
    "component_split_rules": [
      "两张分支卡是独立可点击组件，分别发出 branch_selected 事件",
      "标题、说明文字和分支类型绑定运行时 branch_options 固定槽位，不烘焙进卡框",
      "预览图和节点小岛只作为独立资产槽位，后续可替换为 CharacterArt 或 RouteNodeArt",
      "连接线只表达当前固定路线关系，不根据分支数量运行时重排"
    ]
  },
  "layout_rules": {
    "full_page_image_used_as_runtime_ui": false,
    "computed_layout_used": false,
    "copied_scene": "res://scenes/ui/pages/combat_layout_page.tscn",
    "unchanged_regions": [
      "top_left_resource_hud",
      "top_right_menu_hud",
      "bottom_half_player_formation_and_hud"
    ],
    "runtime_note": "本状态固定描述 2 分支路线选择；branch_options[0] 和 branch_options[1] 只填充既有槽位，不根据数组长度重排。"
  },
